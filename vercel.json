{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/outils/incoterms-2020",
      "destination": "/ressources/incoterms-2020",
      "permanent": true
    },
    {
      "source": "/outils/ia-et-ddmrp",
      "destination": "/ressources/ia-et-ddmrp",
      "permanent": true
    },
    {
      "source": "/audit-supply-chain",
      "destination": "/ressources/audit-supply-chain",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/v1?route=:path*"
    },
    {
      "source": "/ressources/incoterms-2020",
      "destination": "/ressources/incoterms-2020.html"
    },
    {
      "source": "/ressources/ia-et-ddmrp",
      "destination": "/ressources/ia-et-ddmrp.html"
    },
    {
      "source": "/ressources/ddmrp",
      "destination": "/ressources/ddmrp.html"
    },
    {
      "source": "/ressources/audit-supply-chain",
      "destination": "/ressources/audit-supply-chain.html"
    },
    {
      "source": "/ressources/plan-de-chargement-camion",
      "destination": "/ressources/plan-de-chargement-camion.html"
    },
    {
      "source": "/ressources/repartition-des-charges-camion",
      "destination": "/ressources/repartition-des-charges-camion.html"
    },
    {
      "source": "/ressources/controle-factures-transport",
      "destination": "/ressources/controle-factures-transport.html"
    },
    {
      "source": "/ressources/arrimage-des-charges",
      "destination": "/ressources/arrimage-des-charges.html"
    },
    {
      "source": "/ressources",
      "destination": "/ressources/index.html"
    },
    {
      "source": "/chargement-palettisation",
      "destination": "/chargement-palettisation/index.html"
    },
    {
      "source": "/outils",
      "destination": "/outils/index.html"
    },
    {
      "source": "/outils/:id",
      "destination": "/outils/:id/index.html"
    },
    {
      "source": "/a-propos",
      "destination": "/a-propos/index.html"
    },
    {
      "source": "/capacite",
      "destination": "/capacite/index.html"
    },
    {
      "source": "/capacite/:slug",
      "destination": "/capacite/:slug/index.html"
    },
    {
      "source": "/en",
      "destination": "/en/index.html"
    },
    {
      "source": "/en/capacity",
      "destination": "/en/capacity/index.html"
    },
    {
      "source": "/en/capacity/:slug",
      "destination": "/en/capacity/:slug/index.html"
    },
    {
      "source": "/g",
      "destination": "/index.html"
    },
    {
      "source": "/en/loading",
      "destination": "/index.html"
    },
    {
      "source": "/en/:page",
      "destination": "/en/:page/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/v1.js": {
      "maxDuration": 60
    }
  }
}
